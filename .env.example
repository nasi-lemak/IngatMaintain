# Copy to .env and fill in. Everything is optional except SECRET_KEY in production.

# Public address of this app - used for links in reminder emails and the calendar feed.
BASE_URL=http://localhost:8000
SECRET_KEY=change-me-to-a-long-random-string
APP_TIMEZONE=Asia/Singapore
# Hour of day (0-23, local time) for the daily reminder check.
REMINDER_HOUR=8
# Remind again every N days while a site is behind on software (0 = first notice only).
OUTDATED_REMINDER_DAYS=30
# Set to true when served over HTTPS.
SESSION_COOKIE_SECURE=false
# How long a device stays logged in after its last visit.
SESSION_LIFETIME_DAYS=365
# How long a job's share link works at most (it also stops when the job is closed).
SHARE_LINK_DAYS=30

# --- Email reminders (sent to every user with an email and reminders turned on) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_SSL=false

# --- Telegram group reminders (create a bot with @BotFather, add it to your group) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Slack / Microsoft Teams / Google Chat incoming webhook ---
WEBHOOK_URL=

# --- Fleet monitoring (agents on internet-connected client computers) ---
# BASE_URL must be https:// for agents to enroll (the device token is a secret).
# Set to true when a reverse proxy (nginx, Caddy, IIS) terminates HTTPS in front of the app.
BEHIND_PROXY=false
FLEET_MONITOR=true
# How often agents check in, and how often the server looks for offline devices / sends alerts.
FLEET_CHECKIN_MINUTES=5
FLEET_CHECK_MINUTES=5
# Raise an offline alert after this many hours without a check-in (clinic PCs are often off overnight).
FLEET_OFFLINE_HOURS=24
FLEET_CERT_WARN_DAYS=30
# How long a new enrollment key works.
FLEET_ENROLL_DAYS=7
